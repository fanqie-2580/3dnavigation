+  bool EGOReplanFSM::buildRemainingReferenceWaypoints(
+      std::vector<Eigen::Vector3d> &waypoints)
+  {
+    waypoints.clear();
+    if (!projectReferenceProgress(odom_pos_, false) ||
+        reference_path_progress_s_ >= reference_path_total_length_ - 1e-6)
+      return false;
+
+    Eigen::Vector3d projected_position;
+    Eigen::Vector3d tangent;
+    if (!sampleReferencePath(reference_path_progress_s_, projected_position, tangent))
+      return false;
+    (void)tangent;
+
+    constexpr double kWaypointEpsilon = 1e-6;
+    if ((projected_position - odom_pos_).norm() > kWaypointEpsilon)
+      waypoints.push_back(projected_position);
+
+    for (size_t i = 1; i < reference_path_points_.size(); ++i)
+    {
+      if (reference_path_arc_lengths_[i] <= reference_path_progress_s_ + kWaypointEpsilon)
+        continue;
+      if (waypoints.empty() ||
+          (reference_path_points_[i] - waypoints.back()).norm() > kWaypointEpsilon)
+        waypoints.push_back(reference_path_points_[i]);
+    }
+
+    return !waypoints.empty();
+  }
