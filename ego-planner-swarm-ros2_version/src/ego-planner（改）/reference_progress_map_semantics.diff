+  bool EGOReplanFSM::setReferencePath(const std::vector<Eigen::Vector3d> &waypoints)
+  {
+    if (waypoints.size() < 2)
+      return false;
+
+    std::vector<double> arc_lengths(waypoints.size(), 0.0);
+    for (size_t i = 1; i < waypoints.size(); ++i)
+    {
+      const double segment_length = (waypoints[i] - waypoints[i - 1]).norm();
+      if (!std::isfinite(segment_length) || segment_length <= 1e-6)
+        return false;
+      arc_lengths[i] = arc_lengths[i - 1] + segment_length;
+    }
+
+    if (!std::isfinite(arc_lengths.back()) || arc_lengths.back() <= 1e-6)
+      return false;
+
+    reference_path_points_ = waypoints;
+    reference_path_arc_lengths_ = std::move(arc_lengths);
+    reference_path_total_length_ = reference_path_arc_lengths_.back();
+    reference_path_progress_s_ = 0.0;
+    reference_progress_initialized_ = false;
+    reference_progress_fault_ = false;
+    if (!projectReferenceProgress(odom_pos_, true))
+    {
+      reference_path_points_.clear();
+      reference_path_arc_lengths_.clear();
+      reference_path_total_length_ = 0.0;
+      reference_path_progress_s_ = 0.0;
+      return false;
+    }
+    ++reference_path_id_;
+    return true;
+  }
+
+  bool EGOReplanFSM::projectReferenceProgress(const Eigen::Vector3d &position, bool initialize)
+  {
+    if (!position.allFinite() || reference_path_points_.size() < 2 ||
+        reference_path_arc_lengths_.size() != reference_path_points_.size() ||
+        reference_path_total_length_ <= 0.0)
+      return false;
+
+    const double search_start = initialize ? 0.0 : reference_path_progress_s_;
+    const double search_end = initialize
+                                  ? reference_path_total_length_
+                                  : std::min(reference_path_total_length_,
+                                             search_start + reference_path_forward_projection_window_);
+    double best_error = std::numeric_limits<double>::infinity();
+    double best_s = -1.0;
+
+    for (size_t i = 1; i < reference_path_points_.size(); ++i)
+    {
+      const double segment_start_s = reference_path_arc_lengths_[i - 1];
+      const double segment_end_s = reference_path_arc_lengths_[i];
+      if (segment_end_s < search_start || segment_start_s > search_end)
+        continue;
+
+      const Eigen::Vector3d &a = reference_path_points_[i - 1];
+      const Eigen::Vector3d segment = reference_path_points_[i] - a;
+      const double segment_norm_sq = segment.squaredNorm();
+      if (!std::isfinite(segment_norm_sq) || segment_norm_sq <= 1e-12)
+        return false;
+
+      const double lower_t = std::clamp((search_start - segment_start_s) /
+                                            (segment_end_s - segment_start_s),
+                                        0.0, 1.0);
+      const double upper_t = std::clamp((search_end - segment_start_s) /
+                                            (segment_end_s - segment_start_s),
+                                        0.0, 1.0);
+      if (upper_t < lower_t)
+        continue;
+
+      const double unconstrained_t = (position - a).dot(segment) / segment_norm_sq;
+      const double t = std::clamp(unconstrained_t, lower_t, upper_t);
+      const Eigen::Vector3d projected = a + t * segment;
+      const double error = (position - projected).norm();
+      if (error < best_error)
+      {
+        best_error = error;
+        best_s = segment_start_s + t * (segment_end_s - segment_start_s);
+      }
+    }
+
+    if (!std::isfinite(best_error) || best_s < 0.0 ||
+        best_error > reference_path_projection_max_error_)
+      return false;
+
+    reference_path_progress_s_ = initialize ? best_s : std::max(reference_path_progress_s_, best_s);
+    reference_progress_initialized_ = true;
+    reference_progress_fault_ = false;
+    return true;
+  }
+
+  bool EGOReplanFSM::sampleReferencePath(double s, Eigen::Vector3d &position,
+                                         Eigen::Vector3d &tangent) const
+  {
+    if (!std::isfinite(s) || reference_path_points_.size() < 2 ||
+        reference_path_arc_lengths_.size() != reference_path_points_.size() ||
+        s < 0.0 || s > reference_path_total_length_ + 1e-6)
+      return false;
+
+    const double query_s = std::min(s, reference_path_total_length_);
+    for (size_t i = 1; i < reference_path_points_.size(); ++i)
+    {
+      if (query_s > reference_path_arc_lengths_[i] + 1e-6)
+        continue;
+
+      const double segment_length = reference_path_arc_lengths_[i] - reference_path_arc_lengths_[i - 1];
+      if (segment_length <= 1e-6)
+        return false;
+      tangent = (reference_path_points_[i] - reference_path_points_[i - 1]) / segment_length;
+      position = reference_path_points_[i - 1] +
+                 ((query_s - reference_path_arc_lengths_[i - 1]) / segment_length) *
+                     (reference_path_points_[i] - reference_path_points_[i - 1]);
+      return position.allFinite() && tangent.allFinite();
+    }
+    return false;
+  }
+
+  bool EGOReplanFSM::referenceCorridorIsFree(double start_s, double end_s,
+                                             std::string *reason) const
+  {
+    const auto map = planner_manager_ ? planner_manager_->grid_map_ : nullptr;
+    if (!map || !map->hasMapObservation())
+    {
+      if (reason != nullptr)
+        *reason = "no valid local map revision";
+      return false;
+    }
+    if (!std::isfinite(start_s) || !std::isfinite(end_s) || start_s < 0.0 ||
+        end_s < start_s || end_s > reference_path_total_length_ + 1e-6)
+    {
+      if (reason != nullptr)
+        *reason = "invalid reference arc-length interval";
+      return false;
+    }
+
+    const double sample_step = std::max(0.05, map->getResolution());
+    for (double s = start_s; s <= end_s + 1e-6; s += sample_step)
+    {
+      Eigen::Vector3d position, tangent;
+      const double sample_s = std::min(s, end_s);
+      if (!sampleReferencePath(sample_s, position, tangent))
+      {
+        if (reason != nullptr)
+          *reason = "failed to sample reference path";
+        return false;
+      }
+      double yaw = 0.0;
+      if (!planarYaw(Eigen::Vector3d::Zero(), tangent, yaw))
+      {
+        if (reason != nullptr)
+          *reason = "reference path has no planar heading";
+        return false;
+      }
+      const auto collision = map->checkFootprint(position, yaw);
+      if (collision.status != GridMap::FootprintStatus::FREE)
+      {
+        if (reason != nullptr)
+          *reason = "reference footprint is blocked or outside the current map";
+        return false;
+      }
+      if (sample_s >= end_s - 1e-6)
+        break;
+    }
+    return true;
+  }
+
+  bool EGOReplanFSM::canRecoverFromMapRevision()
+  {
+    if (target_type_ != TARGET_TYPE::REFENCE_PATH || reference_progress_fault_ ||
+        !reference_progress_initialized_ || reference_path_id_ != blocked_reference_path_id_)
+      return false;
+
+    const auto map = planner_manager_ ? planner_manager_->grid_map_ : nullptr;
+    if (!map || !map->hasMapObservation() || map->getMapRevision() == blocked_map_revision_)
+      return false;
+
+    blocked_map_revision_ = map->getMapRevision();
+    std::vector<std::pair<Eigen::Vector3d, Eigen::Vector3d>> candidates;
+    getLocalTarget(&candidates);
+    return candidates.size() == 1;
+  }
