+  const Eigen::Vector3i old_max = mp_.map_bound_max_idx_;
+  const Eigen::Vector3i new_min = new_origin - mp_.map_voxel_num_ / 2;
+  const Eigen::Vector3i new_max = new_min + mp_.map_voxel_num_ - Eigen::Vector3i::Ones();
+  for (int x = old_min(0); x <= old_max(0); ++x)
+    for (int y = old_min(1); y <= old_max(1); ++y)
