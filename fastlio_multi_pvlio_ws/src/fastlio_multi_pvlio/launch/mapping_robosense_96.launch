<launch>
    <!-- Launch file for velodyne16 VLP-16 LiDAR -->

    <arg name="rviz" default="true"/>
    <arg name="debug" default="false"/>

    <rosparam command="load" file="$(find fastlio_multi_pvlio)/config/robosens_96.yaml"/>
<!--    <rosparam command="load" file="$(find fastlio_multi_pvlio)/config/robosense_outdoor.yaml"/>-->

    <group if="$(eval arg('debug') == False)">
        <node pkg="fastlio_multi_pvlio" type="fastlio_multi_pvlio_node" name="fastlio_multi_pvlio_node" output="screen"/>
    </group>

    <!--- RS to Velodyne -->
    <node pkg="fastlio_multi_pvlio" type="rs_to_velodyne" name="rs_to_velodyne" output="screen" args="XYZIRT XYZIRT">
        <remap from="/rslidar_points" to="/front_lidar"/>
    </node>

    <group if="$(arg rviz)">
        <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz"
              args="-d $(find fastlio_multi_pvlio)/config/rviz_cfg/voxel_mapping.rviz"/>
    </group>

</launch>