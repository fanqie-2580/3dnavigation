+bool AStar::edgeIsFree(const Vector3d &from, const Vector3d &to, double yaw)
+{
+    const double length = (to - from).norm();
+    if (!std::isfinite(length) || length <= 1e-9)
+        return false;
+
+    const double sample_step = std::max(0.01, grid_map_->getResolution() * 0.5);
+    const int samples = std::max(1, static_cast<int>(std::ceil(length / sample_step)));
+    for (int i = 1; i <= samples; ++i)
+    {
+        const Vector3d sample = from + (to - from) * (static_cast<double>(i) / samples);
+        if (checkOccupancy(sample, yaw))
+            return false;
+    }
+    return true;
+}
