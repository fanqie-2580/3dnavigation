+  double BsplineOptimizer::estimateSegmentYaw(const Eigen::Vector3d &from,
+                                               const Eigen::Vector3d &to) const
+  {
+    const Eigen::Vector2d direction = (to - from).head<2>();
+    if (!direction.allFinite() || direction.norm() < 1e-6)
+      return std::numeric_limits<double>::quiet_NaN();
+    return std::atan2(direction.y(), direction.x());
+  }
+
+  double BsplineOptimizer::estimateControlPointYaw(const Eigen::MatrixXd &points, int index) const
+  {
+    if (points.cols() < 2 || index < 0 || index >= points.cols())
+      return std::numeric_limits<double>::quiet_NaN();
+
+    for (int radius = 1; radius < points.cols(); ++radius)
+    {
+      const int previous = std::max(0, index - radius);
+      const int next = std::min(static_cast<int>(points.cols()) - 1, index + radius);
+      const Eigen::Vector2d direction = (points.col(next) - points.col(previous)).head<2>();
+      if (direction.allFinite() && direction.norm() >= 1e-6)
+        return std::atan2(direction.y(), direction.x());
+    }
+
+    return std::numeric_limits<double>::quiet_NaN();
+  }
+
+  bool BsplineOptimizer::footprintOccupied(const Eigen::Vector3d &position, double yaw) const
+  {
+    if (!grid_map_)
+      return true;
+    return !grid_map_->isFootprintFree(position, yaw);
+  }
